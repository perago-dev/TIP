{
  "compilerOptions": {
    "lib": [
      "es2019"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "target": "ES2019",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "paths": {
      "N/*": [
        "./node_modules/@hitc/netsuite-types/N/*"
      ]
    }
  },
  "files": [
    "./node_modules/@hitc/netsuite-types/N.d.ts",
    "./types/suitescript-globals.d.ts"
  ],
  "include": [
    "./**/*.js"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "scripts",
    "coverage",
    "types",
    "jest.config.js",
    ".eslintrc.js"
  ]
}
